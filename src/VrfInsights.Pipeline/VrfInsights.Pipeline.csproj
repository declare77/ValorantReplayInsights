<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VrfInsights.Pipeline</RootNamespace>
    <AssemblyName>VrfInsights.Pipeline</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project only ever shells out to an already-built vrfkit.exe as an external
         process (System.Diagnostics.Process). It never embeds, links against, or reimplements
         any of vrfkit's decoding/payload-transform code. -->
    <ProjectReference Include="..\VrfInsights.Analysis\VrfInsights.Analysis.csproj" />
  </ItemGroup>

</Project>

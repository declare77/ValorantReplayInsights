<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET for Android (the modern name for what used to be Xamarin.Android). This is a
         normal .NET project type - `dotnet workload install android` is the only extra step
         beyond a regular .NET 10 SDK install. It lets this app reference VrfInsights.Data /
         VrfInsights.Analysis / VrfInsights.Pipeline directly, unmodified: no C#-to-Kotlin port,
         no duplicated logic to keep in sync with the desktop CLI/GUI/server. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.declare77.vrfinsights</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- arm64-v8a only: covers essentially every real Android phone sold since ~2017. Add
         x86_64 here (and build a matching libvrfkit.so under lib\x86_64\) only if you need to
         run this in an emulator rather than on a real device. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <!-- No network permission is declared anywhere in AndroidManifest.xml, and this project
         never requests one: parsing genuinely happens entirely on-device, offline, via the
         bundled vrfkit binary + the existing analysis pipeline. The only network use tied to
         this app happens once, on YOUR machine, before building - see android/README.md
         ("Fetching map/agent art"). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The manifest physically lives under "New folder" instead of the usual "Properties"
         because of a folder-creation limitation hit while assembling this project by hand on
         this machine. .NET for Android's manifest-discovery convention is an ITEM (not a
         property): pointing an explicit <AndroidManifest Include="..."> item at the real path
         overrides the default Properties\AndroidManifest.xml lookup. -->
    <AndroidManifest Include="New folder\AndroidManifest.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VrfInsights.Data\VrfInsights.Data.csproj" />
    <ProjectReference Include="..\..\src\VrfInsights.Analysis\VrfInsights.Analysis.csproj" />
    <ProjectReference Include="..\..\src\VrfInsights.Pipeline\VrfInsights.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The on-device vrfkit binary. Must be placed here (as arm64-v8a/libvrfkit.so) before
         building - see android/README.md ("Building vrfkit for Android"). Android only grants
         execute permission to files installed this way (under the app's nativeLibraryDir); a
         binary merely copied into Assets/ could never be exec'd from app code on API 29+. The
         "lib*.so" name is required by the packaging system - it is still the real vrfkit ELF
         executable underneath, not a shared library. -->
    <AndroidNativeLibrary Include="lib\arm64-v8a\libvrfkit.so" Condition="Exists('lib\arm64-v8a\libvrfkit.so')" />
  </ItemGroup>

  <ItemGroup>
    <!-- viewer/index.html, app.js, ability-meta.js, style.css land in Assets/viewer/, and the
         downloaded map/agent/weapon art (assets/catalog.js etc., generated by
         scripts/Fetch-Assets.ps1) lands in Assets/assets/ - both copied here by
         android/scripts/build-android.ps1 before each build, matching the relative
         "../assets/catalog.js" reference viewer/index.html already uses. See android/README.md.
         Not committed directly under Assets/ so this project never holds a second copy of the
         viewer to keep in sync by hand. -->
    <AndroidAsset Include="Assets\viewer\**\*" />
    <AndroidAsset Include="Assets\assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resources\layout\main.xml similarly lives under Resources\New folder\ instead of
         Resources\layout\ for the same reason as the manifest above. LogicalName remaps the
         path aapt2 sees during packaging back to the conventional "layout/main.xml", so the
         generated Resource.Layout.main binding SetContentView(Resource.Layout.main) relies on
         works exactly as if the file were physically under Resources\layout\. Remove first so
         the default Resources\**\* wildcard glob doesn't also pick this file up unremapped
         (which would make aapt2 choke on an unrecognized "New folder" resource type). -->
    <AndroidResource Remove="Resources\New folder\**\*" />
    <AndroidResource Include="Resources\New folder\main.xml">
      <LogicalName>layout\main.xml</LogicalName>
    </AndroidResource>
  </ItemGroup>

</Project>
